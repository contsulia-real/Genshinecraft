{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "authors": [
    "Contsulia"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.genshinecraft.fabric.GenshinecraftFabric"
    ],
    "client": [
      "dev.genshinecraft.fabric.GenshinecraftFabricClient"
    ],
    "modmenu": [
      "dev.genshinecraft.fabric.GenshinecraftModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "architectury": ">=${architectury_version}",
    "minecraft": "${minecraft_version}"
  },
  "mixins": [
    "genshinecraft.mixins.json"
  ],
  "suggests": {
    "modmenu": "*"
  }
}
